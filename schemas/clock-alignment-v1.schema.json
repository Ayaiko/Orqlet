{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orqlet:alignment:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "capture_id", "capture_sha256", "timeline_sha256", "input_index", "uncertainty_ms", "anchors"],
  "properties": {
    "schema": {"const": "orqlet.alignment.v1"},
    "capture_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "capture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timeline_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_index": {"type": "integer", "minimum": 1, "maximum": 16},
    "uncertainty_ms": {"type": "number", "minimum": 0, "maximum": 250},
    "anchors": {
      "type": "array",
      "minItems": 2,
      "maxItems": 301,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host_sample_id", "source_unix_ms"],
        "properties": {
          "host_sample_id": {"type": "string", "pattern": "^s[1-9][0-9]*$"},
          "source_unix_ms": {"type": "number", "minimum": -62135596800000, "maximum": 253402300799999}
        }
      }
    }
  }
}
