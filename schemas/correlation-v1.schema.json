{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orqlet:correlation:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "capture_id",
    "input_index",
    "alignment_evidence",
    "alignment_uncertainty_ms",
    "metadata_coverage_ms",
    "untimed_events",
    "intervals",
    "interpretation",
    "source_clock_continuity"
  ],
  "properties": {
    "schema": {"const": "orqlet.correlation.v1"},
    "capture_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "input_index": {"type": "integer", "minimum": 1, "maximum": 16},
    "alignment_evidence": {"const": "caller_supplied_anchors"},
    "alignment_uncertainty_ms": {"type": "number", "minimum": 0, "maximum": 250},
    "metadata_coverage_ms": {"type": "number", "minimum": 0},
    "untimed_events": {"type": "integer", "minimum": 0},
    "intervals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sample_id",
          "interval_start_unix_ms",
          "interval_end_unix_ms",
          "aligned_window_ms",
          "unaligned_or_unusable_ms",
          "metadata_coverage_ms",
          "missing_metadata_ms",
          "activity_union_ms",
          "evidence_unions",
          "cpu_busy_percent",
          "cpu_quality",
          "swap_in_bytes",
          "swap_out_bytes",
          "swap_delta_quality",
          "pressure_state_at_sample",
          "pressure_evidence"
        ],
        "properties": {
          "sample_id": {"type": "string", "pattern": "^s[1-9][0-9]*$"},
          "interval_start_unix_ms": {"type": "number", "minimum": -62135596800000, "maximum": 253402300799999},
          "interval_end_unix_ms": {"type": "number", "minimum": -62135596800000, "maximum": 253402300799999},
          "aligned_window_ms": {"type": "number", "minimum": 0},
          "unaligned_or_unusable_ms": {"type": "number", "minimum": 0},
          "metadata_coverage_ms": {"type": "number", "minimum": 0},
          "missing_metadata_ms": {"type": "number", "minimum": 0},
          "activity_union_ms": {"type": "number", "minimum": 0},
          "evidence_unions": {
            "type": "array",
            "minItems": 0,
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["category", "evidence", "source", "union_ms"],
              "properties": {
                "category": {
                  "enum": [
                    "tool",
                    "command",
                    "reasoning",
                    "response",
                    "agent_wait",
                    "user_wait",
                    "task_window",
                    "unattributed"
                  ]
                },
                "evidence": {"enum": ["verified_metadata", "inferred", "caller_declared", "unknown"]},
                "source": {
                  "enum": [
                    "codex_item_metadata",
                    "claude_reported_thinking_duration",
                    "paired_log_timestamps",
                    "inferred_paired_agent_wait_identity",
                    "caller_declared_span",
                    "task_boundary",
                    "unpaired_tool_call",
                    "unattributed_task_residual"
                  ]
                },
                "union_ms": {"type": "number", "minimum": 0}
              }
            }
          },
          "cpu_busy_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
          "cpu_quality": {
            "enum": [
              "available",
              "baseline",
              "clock_discontinuity",
              "stale_interval",
              "denied",
              "unavailable",
              "counter_reset",
              "no_counter_progress"
            ]
          },
          "swap_in_bytes": {"type": ["integer", "null"], "minimum": 0},
          "swap_out_bytes": {"type": ["integer", "null"], "minimum": 0},
          "swap_delta_quality": {
            "enum": [
              "available",
              "baseline",
              "clock_discontinuity",
              "stale_interval",
              "denied",
              "unavailable",
              "counter_reset",
              "page_size_changed"
            ]
          },
          "pressure_state_at_sample": {"enum": ["unknown", "normal", "warning", "critical"]},
          "pressure_evidence": {"enum": ["awaiting_event", "event_observed", "unavailable", "coalesced_events"]}
        }
      }
    },
    "interpretation": {
      "const": "Temporal correlation only, not causation or execution concurrency. Anchor evidence is caller-supplied, not authenticated. Overlapping evidence unions must not be added. Pressure is the last observed event, not interval duration. Unrelated builds/tests are not observed."
    },
    "source_clock_continuity": {"const": "unverified"}
  }
}
